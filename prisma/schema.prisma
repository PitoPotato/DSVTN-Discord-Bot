generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model GuildConfig {
  guildId              String @id
  renameWarningChannelId String?
  leaderRoleId         String?
  technicianRoleId     String?
  verifiedRoleId       String?
  unverifiedRoleId     String?
  notificationFooterText String?
  notificationFooterIconUrl String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

/// A bot-level role.  It is deliberately separate from Discord's Role object:
/// one authorization role can be linked to one or more Discord roles and owns
/// a set of string permissions.
model AuthorizationRole {
  id          String                        @id @default(cuid())
  guildId     String
  key         String
  name        String
  description String?
  isSystem    Boolean                       @default(false)
  createdAt   DateTime                      @default(now())
  updatedAt   DateTime                      @updatedAt
  permissions AuthorizationRolePermission[]
  bindings    AuthorizationRoleBinding[]

  @@unique([guildId, key])
  @@index([guildId])
}

/// Each permission is stored as a human-readable string, for example
/// `identity.write` or `reaction_role.manage`; no bitmasks are used.
model AuthorizationRolePermission {
  id        String            @id @default(cuid())
  roleId    String
  permission String
  createdAt DateTime          @default(now())
  role      AuthorizationRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permission])
  @@index([permission])
}

/// Maps a Discord role to an authorization role. A Discord role may carry
/// several bot authorization roles if needed.
model AuthorizationRoleBinding {
  id            String            @id @default(cuid())
  roleId        String
  discordRoleId String
  createdAt     DateTime          @default(now())
  role          AuthorizationRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, discordRoleId])
  @@index([discordRoleId])
}

enum ReactionRoleStyle {
  BUTTON
  MENU
}

enum ReactionRoleAction {
  ADD_ONLY
  REMOVE_ONLY
  TOGGLE
}

model ReactionRolePanel {
  id            String              @id @default(cuid())
  guildId       String
  name          String
  style         ReactionRoleStyle
  action        ReactionRoleAction
  maxSelections Int                 @default(1)
  title         String
  titleUrl      String?
  description   String?
  color         Int                 @default(3447003)
  authorName    String?
  authorIconUrl String?
  footer        String?
  footerIconUrl String?
  imageUrl      String?
  thumbnailUrl  String?
  channelId     String?
  messageId     String?
  isEnabled     Boolean             @default(true)
  createdBy     String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  items         ReactionRoleItem[]
  fields        ReactionRoleEmbedField[]

  @@unique([guildId, name])
  @@index([guildId, isEnabled])
}

model ReactionRoleEmbedField {
  id        String            @id @default(cuid())
  panelId   String
  name      String
  value     String
  inline    Boolean           @default(false)
  position  Int               @default(0)
  createdAt DateTime          @default(now())
  panel     ReactionRolePanel @relation(fields: [panelId], references: [id], onDelete: Cascade)

  @@index([panelId, position])
}

model ReactionRoleItem {
  id          String            @id @default(cuid())
  panelId     String
  roleId      String
  label       String
  emoji       String?
  description String?
  position    Int               @default(0)
  createdAt   DateTime          @default(now())
  panel       ReactionRolePanel @relation(fields: [panelId], references: [id], onDelete: Cascade)

  @@unique([panelId, roleId])
  @@index([panelId, position])
}

model VerifiedMember {
  id         String   @id @default(cuid())
  guildId    String
  userId     String
  fullName   String
  verifiedAt DateTime @default(now())
  verifiedBy String?
  updatedAt  DateTime @updatedAt
  isActive   Boolean  @default(true)

  @@unique([guildId, userId])
  @@index([guildId, fullName])
}
